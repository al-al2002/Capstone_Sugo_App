{
  // Flutter drives its own Gradle build. Letting the Java extension import
  // android/ as a second Gradle project makes the two race for
  // android/.gradle/noVersion/buildLogic.lock, which surfaces as
  // "Timeout waiting to lock build logic queue ... in use by another Gradle
  // instance". Native Android work belongs in Android Studio.
  "java.import.gradle.enabled": false,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/android/**",
    "**/build/**",
    "**/.gradle/**"
  ],

  // Build output churns constantly and is not worth watching or searching.
  "files.watcherExclude": {
    "**/.gradle/**": true,
    "**/.dart_tool/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/.gradle/**": true,
    "**/.dart_tool/**": true,
    "**/build/**": true
  },

  "dart.lineLength": 80,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.rulers": [80]
  },
  "java.configuration.updateBuildConfiguration": "interactive"
}
