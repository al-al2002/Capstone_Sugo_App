        <mxCell id="important-messages" value="&lt;b&gt;job_messages&lt;/b&gt;&lt;hr&gt;PK id&lt;br&gt;FK job_id -&gt; jobs&lt;br&gt;FK sender_id -&gt; profiles&lt;br&gt;body&lt;br&gt;read_at" style="shape=swimlane;childLayout=stackLayout;horizontal=1;startSize=30;rounded=0;html=1;whiteSpace=wrap;fillColor=#edf9f1;strokeColor=#58a876;fontSize=12;align=left;spacingLeft=10;swimlaneFillColor=#d7f0df" vertex="1" parent="important-1">
