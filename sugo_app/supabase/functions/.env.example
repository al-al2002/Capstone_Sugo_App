# Local secrets for `supabase functions serve`.
#
# Copy to `.env.local` in this same folder and fill in real keys.
# `.env.local` is git-ignored; this example file is not.
#
# Deployed functions do NOT read this file - they read the secrets set with
#   npx supabase secrets set TOMTOM_API_KEY=...

TOMTOM_API_KEY=your_tomtom_key_here
OPENWEATHER_API_KEY=your_openweathermap_key_here
